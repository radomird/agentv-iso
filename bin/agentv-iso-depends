#!/bin/bash

# agentv:summary=Put AgenTV's packages in the ISO's offline mirror and root image, for one build
# agentv:args=[--restore]

# The installer installs a prebuilt root image, which omarchy-iso's build
# (builder/build-iso.sh) makes from its offline mirror before mkarchiso runs,
# and it records the mirror's checksums as it goes. So AgenTV's packages have
# to be there from the start, as a repository the build downloads from, and
# on the list of what every install gets. Too late, and the box is installed
# without AgenTV.
#
# For one build only, in the working tree:
#   - AgenTV's packages, which bin/agentv-iso-packages or a workflow put in
#     configs/airootfs/usr/share/agentv-iso/packages, become a local
#     repository, [agentv-iso], indexed with repo-add in an Arch container;
#   - each x86_64 configs/pacman-online-*.conf gets that repository, so the
#     build downloads agentv and everything it depends on into the mirror;
#   - builder/archinstall.packages names agentv-keyring and agentv, so they
#     go into the root image, and so onto every box.
# test/agentv/image/ci runs it before omarchy-iso-make, and --restore puts
# upstream's files back from git and removes the index.
#
# Their signatures were checked before they got here (agentv-iso-packages),
# or a workflow built and signed them itself, so the build's own pacman,
# which doesn't know AgenTV's key, doesn't check them again.

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT"

list=builder/archinstall.packages
confs=(configs/pacman-online-stable.conf configs/pacman-online-rc.conf configs/pacman-online-edge.conf)
packages=configs/airootfs/usr/share/agentv-iso/packages
# Where the build's container sees the packages: omarchy-iso-make mounts
# configs/ at /configs.
server="file:///configs/airootfs/usr/share/agentv-iso/packages"
repo="agentv-iso"

if [[ ${1:-} == "--restore" ]]; then
  git checkout -- "$list" "${confs[@]}"
  rm -f "$packages/$repo".{db,files}{,.tar.gz,.tar.gz.old}
  exit 0
fi

# git checkout puts them back afterwards, which would lose edits of anyone's.
if ! git diff --quiet -- "$list" "${confs[@]}"; then
  echo "agentv-iso-depends: $list or a pacman-online conf is changed already; run it with --restore first" >&2
  exit 1
fi

shopt -s nullglob
agentv=("$packages"/agentv-[0-9]*.pkg.tar.zst)
archives=("$packages"/*.pkg.tar.zst)
shopt -u nullglob
if (( ${#agentv[@]} != 1 )); then
  echo "agentv-iso-depends: expected one agentv package in $packages, found ${#agentv[@]}" >&2
  exit 1
fi

docker=(docker)
docker version >/dev/null 2>&1 || docker=(sudo docker)
names=()
for archive in "${archives[@]}"; do
  names+=("/packages/${archive##*/}")
done
"${docker[@]}" run --rm --user "$(id -u):$(id -g)" -v "$ROOT/$packages:/packages" \
  ghcr.io/archlinux/archlinux:latest repo-add --quiet "/packages/$repo.db.tar.gz" "${names[@]}"

for conf in "${confs[@]}"; do
  printf '\n# AgenTV'\''s packages, for this build only (bin/agentv-iso-depends).\n[%s]\nSigLevel = Never\nServer = %s\n' \
    "$repo" "$server" >>"$conf"
done

added=()
for name in agentv-keyring agentv; do
  if ! grep -qxF "$name" "$list"; then
    printf '%s\n' "$name" >>"$list"
    added+=("$name")
  fi
done

echo "agentv-iso-depends: [$repo] has ${#archives[@]} packages, and every install gets ${added[*]:-what it had}"
