#!/bin/bash

# agentv:summary=Put an ISO where people download it, under its version's name
# agentv:args=names <channel> <iso.sha256> <dir> | upload <channel> <iso> <dir> | stale <channel> | clean <channel>

# AgenTV's ISOs live in a Cloudflare R2 bucket, since an ISO is over GitHub's
# 2 GiB cap for release files. The bucket's iso/ folder holds one ISO for
# each channel: the latest stable release, last night's edge build, and the
# latest release candidate. Each ISO goes by its version, so the file you
# download says what it is:
#
#   iso/agentv-<version>-x86_64.iso             the ISO
#   iso/agentv-<version>-x86_64.iso.sha256      its checksum, which names that file
#   iso/agentv-<version>-x86_64.iso.sha256.sig  the checksum, signed with AgenTV's key
#   iso/<channel>.json                          which ISO the channel is on now
#
# A version says which channel it belongs to:
#
#   stable  1.0.0
#   rc      1.0.0-rc1
#   edge    0.2.0.r422.g155320d30, the version of the agentv package on it,
#           which is what "agentv version" prints on a box installed from
#           it. A build that's only named by its day and commit keeps that
#           name: edge-2026.11.10-abc1234.
#
# <channel>.json is the link that doesn't change. It has the ISO's file
# name, version, sha256 and address, and it's written last: only once the
# ISO, its checksum and its signature are in the bucket and checked. If
# anything before that fails, it still points at the ISO before.
#
#   names <channel> <iso.sha256> <dir>
#       Checks the checksum file a build left beside its ISO
#       (agentv-1.0.0-x86_64.iso.sha256) and writes it into <dir>. Needs no
#       keys. That file is what gets signed, before the upload.
#   upload <channel> <iso> <dir>
#       Checks the ISO against <dir>'s checksum, uploads the ISO and what's
#       in <dir>, asks the bucket for each file's size and compares, and
#       then moves <channel>.json to the new ISO.
#       The ISO <channel>.json points at is never replaced: the same ISO
#       again keeps its bytes and only gets its checksum and signature
#       again, and a different ISO under that name is refused.
#   stale <channel>
#       Prints what clean would remove, one key a line, and removes nothing.
#   clean <channel>
#       Removes those, one at a time, each by its exact key.
#
# stale and clean take out the ISOs a channel had before, with their
# checksums and signatures. They only ever name a key that is right under
# iso/, carries that channel's kind of version (or is one of the channel's
# files from when they were called agentv-<channel>.iso), and isn't the ISO
# <channel>.json points at. Another channel's files and anything else in
# the bucket stay.
#
# Nothing is removed unless the listing is whole. The bucket has to say the
# listing isn't cut short, and the listing has to show what is known to be
# there: <channel>.json, read straight from the bucket by its key, and the
# ISO and checksum it names. More than AGENTV_ISO_STALE_MAX (20) keys to
# remove stops it too.
#
# R2 speaks S3, so the AWS CLI on GitHub's runners does the work. The bucket
# and its keys come from the environment, which CI fills from the repo's
# secrets and variables. None of them is in the repo.

set -euo pipefail

usage() {
  echo "usage: agentv-iso-publish names <channel> <iso.sha256> <dir> | upload <channel> <iso> <dir> | stale <channel> | clean <channel>" >&2
  exit 2
}

CHANNELS=(edge stable rc)
PREFIX=iso/

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

channel_ok() {
  local channel
  for channel in "${CHANNELS[@]}"; do
    [[ $1 == "$channel" ]] && return 0
  done
  echo "agentv-iso-publish: the channel is edge, stable or rc, not '$1'" >&2
  return 1
}

# The versions a channel's ISOs carry, as a pattern. No two channels share
# one, so a file's name says whose it is.
channel_versions() {
  case $1 in
    stable) echo '[0-9]+\.[0-9]+\.[0-9]+' ;;
    rc) echo '[0-9]+\.[0-9]+\.[0-9]+-rc[0-9]+' ;;
    edge) echo '([0-9]+\.[0-9]+\.[0-9]+\.r[0-9]+\.g[0-9a-f]{7,40}|edge-([0-9]{4}\.[0-9]{2}\.[0-9]{2}-)?[0-9a-f]{7})' ;;
  esac
}

# Is $2 the file name of one of channel $1's ISOs?
channel_iso() {
  [[ $2 =~ ^agentv-$(channel_versions "$1")-x86_64\.iso$ ]]
}

r2() {
  : "${R2_ACCOUNT_ID:?set R2_ACCOUNT_ID to the ID of the Cloudflare account}"
  : "${R2_ACCESS_KEY_ID:?set R2_ACCESS_KEY_ID to the access key of the R2 token}"
  : "${R2_SECRET_ACCESS_KEY:?set R2_SECRET_ACCESS_KEY to the secret of the R2 token}"
  : "${R2_BUCKET:?set R2_BUCKET to the name of the bucket}"
  export AWS_ACCESS_KEY_ID=$R2_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY=$R2_SECRET_ACCESS_KEY AWS_DEFAULT_REGION=auto
  # R2 doesn't take the checksums newer AWS CLIs add to every upload.
  export AWS_REQUEST_CHECKSUM_CALCULATION=when_required AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
  endpoint="https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com"
}

# Reads one ISO's checksum file into the caller's $hash and $file, or stops.
read_sum() {
  local sum=$1
  [[ -f $sum ]] || { echo "agentv-iso-publish: no checksum file at $sum" >&2; exit 1; }
  # One line, "<sha256>  <name>.iso", as sha256sum writes it.
  [[ $(wc -l <"$sum") == 1 ]] || { echo "agentv-iso-publish: $sum isn't one ISO's checksum" >&2; exit 1; }
  read -r hash file <"$sum"
  file=${file#\*}
  if [[ ! $hash =~ ^[0-9a-f]{64}$ || ! $file =~ ^agentv-[A-Za-z0-9.]+(-[A-Za-z0-9.]+)*-x86_64\.iso$ ]]; then
    echo "agentv-iso-publish: $sum isn't an AgenTV ISO's checksum" >&2
    exit 1
  fi
}

names() {
  local channel=$1 sum=$2 dir=$3 hash file version
  channel_ok "$channel"
  read_sum "$sum"
  # agentv-1.0.0-x86_64.iso is 1.0.0.
  version=${file#agentv-}
  version=${version%-x86_64.iso}
  if ! channel_iso "$channel" "$file"; then
    echo "agentv-iso-publish: $file isn't a $channel ISO. A stable version looks like 1.0.0, an rc's like 1.0.0-rc1 and edge's like 0.2.0.r422.g155320d30." >&2
    exit 1
  fi
  mkdir -p "$dir"
  printf '%s  %s\n' "$hash" "$file" >"$dir/$file.sha256"
  # A signature left from an earlier run isn't this checksum's.
  if [[ -e $dir/$file.sha256.sig ]]; then
    unlink "$dir/$file.sha256.sig"
  fi
  echo "$file is the $channel ISO, version $version, sha256 $hash"
}

# Stops unless the bucket's copy of $2 is as big as the file at $1.
same_size() {
  local size served
  size=$(stat -c %s "$1")
  served=$(aws s3api head-object --endpoint-url "$endpoint" --bucket "$R2_BUCKET" --key "$PREFIX$2" \
    --query ContentLength --output text)
  if [[ $served != "$size" ]]; then
    echo "agentv-iso-publish: the bucket's $PREFIX$2 is $served bytes, expected $size" >&2
    exit 1
  fi
}

upload() {
  local channel=$1 iso=$2 dir=$3 hash file version item live
  local -a sums files
  channel_ok "$channel"
  : "${ISO_URL:?set ISO_URL to the public address of the bucket}"
  r2
  # <dir> has one checksum file, the one names wrote. It says what the ISO
  # is called.
  sums=("$dir"/agentv-*-x86_64.iso.sha256)
  if (( ${#sums[@]} != 1 )) || [[ ! -s ${sums[0]} ]]; then
    echo "agentv-iso-publish: need one ISO's checksum file in $dir" >&2
    exit 1
  fi
  read_sum "${sums[0]}"
  if [[ ${sums[0]##*/} != "$file.sha256" ]] || ! channel_iso "$channel" "$file"; then
    echo "agentv-iso-publish: ${sums[0]} isn't a $channel ISO's checksum" >&2
    exit 1
  fi
  [[ -s $iso ]] || { echo "agentv-iso-publish: need $iso" >&2; exit 1; }
  # Check the ISO by its hash before anything leaves.
  if [[ $(sha256sum "$iso" | cut -d' ' -f1) != "$hash" ]]; then
    echo "agentv-iso-publish: $iso isn't the ISO $dir/$file.sha256 is the checksum of" >&2
    exit 1
  fi
  version=${file#agentv-}
  version=${version%-x86_64.iso}

  # Is this the ISO people are downloading right now? Then its bytes stay
  # as they are: a download under way, and the checksum people have, both
  # count on them. The same ISO again only gets what describes it (a
  # signature it went out without, say). Other bytes under the live name
  # are refused.
  live=""
  if aws s3api get-object --endpoint-url "$endpoint" --bucket "$R2_BUCKET" --key "$PREFIX$channel.json" "$WORK/live.json" \
    >/dev/null 2>"$WORK/live.err"; then
    if [[ $(jq -r 'if type == "object" then .file else "" end' "$WORK/live.json" 2>/dev/null || true) == "$file" ]]; then
      live=$(jq -r '.sha256 | strings' "$WORK/live.json")
      if [[ $live != "$hash" ]]; then
        echo "agentv-iso-publish: $file is the $channel ISO people download now, with sha256 ${live:-(none)}, and this one's is $hash. A published ISO isn't replaced under the same name, so nothing is uploaded. Publish this one as a new version." >&2
        exit 1
      fi
    fi
  elif ! grep -qE 'NoSuchKey|\(404\)' "$WORK/live.err"; then
    # No file yet is a first publish. Anything else, and it isn't known
    # which ISO is live.
    cat "$WORK/live.err" >&2
    echo "agentv-iso-publish: couldn't read the bucket's $PREFIX$channel.json, so nothing is uploaded" >&2
    exit 1
  fi

  # The ISO first, then what describes it. With no signature this time, one
  # an earlier publish left under this name goes: it isn't this checksum's.
  files=("$iso:$file" "$dir/$file.sha256:$file.sha256")
  if [[ -s $dir/$file.sha256.sig ]]; then
    files+=("$dir/$file.sha256.sig:$file.sha256.sig")
  fi
  for item in "${files[@]}"; do
    # The live ISO is in the bucket already, whole. The size check below
    # stops the publish if it isn't.
    if [[ -n $live && ${item##*:} == "$file" ]]; then
      echo "$file is the $channel ISO already, with the same sha256, so it isn't uploaded again." >&2
      continue
    fi
    aws s3 cp --endpoint-url "$endpoint" --only-show-errors "${item%%:*}" "s3://$R2_BUCKET/$PREFIX${item##*:}" >&2
  done
  # The live ISO's signature is this checksum's too, so it stays.
  if [[ ! -s $dir/$file.sha256.sig && -z $live ]]; then
    aws s3api delete-object --endpoint-url "$endpoint" --bucket "$R2_BUCKET" --key "$PREFIX$file.sha256.sig" >&2
  fi

  # What the bucket has now, by size.
  for item in "${files[@]}"; do
    same_size "${item%%:*}" "${item##*:}"
  done

  # The link that doesn't change, last of all. Everything above is in the
  # bucket at its full size by now. A publish that failed before this line
  # leaves <channel>.json on the ISO before.
  jq -n --arg channel "$channel" --arg version "$version" --arg file "$file" --arg sha256 "$hash" \
    --arg url "${ISO_URL%/}/$PREFIX$file" \
    '{channel: $channel, version: $version, file: $file, sha256: $sha256, url: $url}' >"$WORK/$channel.json"
  aws s3 cp --endpoint-url "$endpoint" --only-show-errors "$WORK/$channel.json" "s3://$R2_BUCKET/$PREFIX$channel.json" >&2
  same_size "$WORK/$channel.json" "$channel.json"

  echo "${ISO_URL%/}/$PREFIX$file"
}

# Prints the keys of the ISOs channel $1 had before, one a line. Fails,
# printing none, when the listing can't be trusted or too many would go.
stale() {
  local channel=$1 max=${AGENTV_ISO_STALE_MAX:-20} listing key name current need
  local -a keys gone=()
  channel_ok "$channel" || return 1
  r2
  [[ $max =~ ^[0-9]+$ ]] || { echo "agentv-iso-publish: AGENTV_ISO_STALE_MAX is a number" >&2; return 1; }

  # Which ISO the channel is on, read by its exact key, not from a listing.
  if ! aws s3api get-object --endpoint-url "$endpoint" --bucket "$R2_BUCKET" --key "$PREFIX$channel.json" "$WORK/now.json" >/dev/null; then
    echo "agentv-iso-publish: couldn't read the bucket's $PREFIX$channel.json, so nothing is removed. Publish a $channel ISO first." >&2
    return 1
  fi
  current=$(jq -r 'if type == "object" and (.file | type) == "string" then .file else "" end' "$WORK/now.json" 2>/dev/null || true)
  if ! channel_iso "$channel" "$current"; then
    echo "agentv-iso-publish: the bucket's $PREFIX$channel.json doesn't name a $channel ISO, so nothing is removed" >&2
    return 1
  fi

  # One page, and the bucket's own word on whether there's more. iso/ holds
  # a dozen keys, so a listing that needs a second page isn't this folder
  # as it should be.
  if ! listing=$(aws s3api list-objects-v2 --endpoint-url "$endpoint" --bucket "$R2_BUCKET" --prefix "$PREFIX" \
    --no-paginate --max-keys 1000 --query '{keys: Contents[].Key, truncated: IsTruncated, count: KeyCount}' --output json); then
    echo "agentv-iso-publish: couldn't list the bucket's $PREFIX, so nothing is removed" >&2
    return 1
  fi
  if ! jq -e 'type == "object" and (.keys | type) == "array" and all(.keys[]; type == "string")' <<<"$listing" >/dev/null 2>&1; then
    echo "agentv-iso-publish: the bucket's listing of $PREFIX isn't a list of keys, so nothing is removed" >&2
    return 1
  fi
  if ! jq -e '.truncated == false and (.count == null or .count == (.keys | length))' <<<"$listing" >/dev/null 2>&1; then
    echo "agentv-iso-publish: the bucket's listing of $PREFIX is cut short, so nothing is removed" >&2
    return 1
  fi
  mapfile -t keys < <(jq -r '.keys[]' <<<"$listing")

  # A whole listing shows what is known to be there. One that doesn't is
  # the wrong bucket, the wrong folder or a listing gone wrong.
  for need in "$channel.json" "$current" "$current.sha256"; do
    if ! printf '%s\n' "${keys[@]}" | grep -qxF -- "$PREFIX$need"; then
      echo "agentv-iso-publish: the listing of $PREFIX doesn't show $need, which is there. It isn't whole, so nothing is removed." >&2
      return 1
    fi
  done

  for key in "${keys[@]}"; do
    # Right under iso/, a plain name, and nothing else in the bucket.
    [[ $key =~ ^iso/[A-Za-z0-9._-]+$ ]] || continue
    name=${key#"$PREFIX"}
    # The version note the channel had under its old name.
    if [[ $name == "agentv-$channel.version" ]]; then
      gone+=("$key")
      continue
    fi
    # An ISO, its checksum or the checksum's signature.
    [[ $name =~ ^(.+\.iso)(\.sha256(\.sig)?)?$ ]] || continue
    name=${BASH_REMATCH[1]}
    # Never the one the channel is on.
    [[ $name != "$current" ]] || continue
    # This channel's, by its version or by the channel's old name.
    if channel_iso "$channel" "$name" || [[ $name == "agentv-$channel.iso" ]]; then
      gone+=("$key")
    fi
  done

  if (( ${#gone[@]} > max )); then
    echo "agentv-iso-publish: ${#gone[@]} keys would go, more than $max, so nothing is removed. Look at the bucket first:" >&2
    printf '  %s\n' "${gone[@]}" >&2
    return 1
  fi
  (( ${#gone[@]} == 0 )) || printf '%s\n' "${gone[@]}"
}

clean() {
  local channel=$1 list key
  local -a gone
  list=$(stale "$channel") || exit 1
  if [[ -z $list ]]; then
    echo "Nothing to remove: iso/ has one $channel ISO and what goes with it."
    return 0
  fi
  r2
  mapfile -t gone <<<"$list"
  for key in "${gone[@]}"; do
    # Once more, right before it goes: under iso/, a plain name, no wildcard.
    [[ $key =~ ^iso/[A-Za-z0-9._-]+$ ]] || { echo "agentv-iso-publish: won't remove '$key'" >&2; exit 1; }
    aws s3api delete-object --endpoint-url "$endpoint" --bucket "$R2_BUCKET" --key "$key" >/dev/null
    echo "Removed $key"
  done
}

case ${1:-} in
  names) (( $# == 4 )) || usage; names "$2" "$3" "$4" ;;
  upload) (( $# == 4 )) || usage; upload "$2" "$3" "$4" ;;
  stale)
    (( $# == 2 )) || usage
    list=$(stale "$2") || exit 1
    if [[ -z $list ]]; then
      echo "Nothing would be removed: iso/ has one $2 ISO and what goes with it."
    else
      echo "These would be removed:"
      while IFS= read -r key; do
        echo "  $key"
      done <<<"$list"
    fi
    ;;
  clean) (( $# == 2 )) || usage; clean "$2" ;;
  *) usage ;;
esac
