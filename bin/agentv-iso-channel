#!/bin/bash

# agentv:summary=Say which of Omarchy's channels the ISO builds from
# agentv:args=

# AgenTV's ISO follows omarchy-iso's branch for an Omarchy release
# (.github/omarchy-release), and that installer wants that release's
# packages. Omarchy tags a release before its stable channel serves it: rc
# has it first, and stable gets it when Omarchy promotes rc. omarchy-iso's
# own release ISO is built with --stable-from-rc in that window: rc's
# packages, installed onto the stable channel. AgenTV's does the same.
#
# Prints the omarchy-iso-make flag to build with: nothing when stable serves
# the release (or a newer one), --stable-from-rc when only rc has it. Fails
# when neither does, rather than build an installer with packages it wasn't
# made for.
#
# OMARCHY_PKGS_URL points at another package server, for the tests.

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
pkgs=${OMARCHY_PKGS_URL:-https://pkgs.omarchy.org}
release=$(sed -n '1{s/[[:space:]]//g;p;}' "$ROOT/.github/omarchy-release")
want=${release#v}

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# The omarchy package's version on a channel, such as 4.5.0.
served() {
  curl -fsSL --retry 5 --retry-delay 5 -o "$work/$1.db" "$pkgs/$1/x86_64/omarchy.db" || return 1
  tar -tf "$work/$1.db" | sed -n 's#^omarchy-\([0-9][^-/]*\)-[0-9][^/]*/$#\1#p' | sort -V | tail -n 1
}

# at_least <version> <wanted>
at_least() {
  [[ -n $1 && $(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n 1) == "$2" ]]
}

stable=$(served stable) || { echo "agentv-iso-channel: couldn't read Omarchy's stable channel" >&2; exit 1; }
if at_least "$stable" "$want"; then
  echo "agentv-iso-channel: Omarchy's stable channel serves omarchy $stable, so the ISO builds from stable" >&2
  exit 0
fi

# Only rc's own build of the release: an rc that has moved on to the next one
# isn't what this installer was made for.
rc=$(served rc) || { echo "agentv-iso-channel: couldn't read Omarchy's rc channel" >&2; exit 1; }
if [[ $rc == "$want" ]]; then
  echo "agentv-iso-channel: stable still serves omarchy $stable, so the ISO builds $release from rc's packages, onto stable" >&2
  echo "--stable-from-rc"
  exit 0
fi

echo "agentv-iso-channel: neither stable ($stable) nor rc (${rc:-nothing}) serves omarchy $want for $release" >&2
exit 1
