#!/bin/bash

# agentv:summary=Fetch AgenTV's signed packages for the ISO's build step
# agentv:args=<stable|edge> [<packages-dir>]

# Downloads agentv, agentv-keyring and agentv-voice from the agentv-pkgs
# release for a channel and checks every signature against AgenTV's key,
# whose fingerprint is pinned in
# configs/airootfs/usr/share/agentv-iso/key-fingerprint. They land where
# the ISO's build step (customize.sh) picks them up. The owner
# comes from AGENTV_OWNER, which CI sets from GitHub's own context, so moving
# the repos changes no code.

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
channel="${1:?usage: agentv-iso-packages <stable|edge> [<packages-dir>]}"
dest="${2:-$ROOT/configs/airootfs/usr/share/agentv-iso/packages}"
: "${AGENTV_OWNER:?set AGENTV_OWNER to the GitHub owner of agentv-pkgs}"

url="https://github.com/$AGENTV_OWNER/agentv-pkgs/releases/download/$channel"
pinned=$(tr -d '[:space:]' <"$ROOT/configs/airootfs/usr/share/agentv-iso/key-fingerprint")

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
export GNUPGHOME="$work/gnupg"
mkdir -m 700 "$GNUPGHOME"

# GitHub's release downloads now and then answer 500 for a few seconds, so
# keep trying for up to five minutes before calling the build broken.
fetch() {
  curl -fsSL --retry 8 --retry-delay 15 --retry-max-time 300 -o "$work/$1" "$url/$1"
}

fetch agentv.db
fetch agentv.db.sig

# The packages the repository lists now, by name and file name: agentv and
# agentv-keyring, and agentv-voice, which has Piper and its cori voice
# (Q157), when it's there. It has to be once agentv depends on it. Nothing
# else belongs in AgenTV's repository.
mkdir "$work/db"
tar -xzf "$work/agentv.db" -C "$work/db"
names=()
files=()
for desc in "$work"/db/*/desc; do
  names+=("$(awk '/^%NAME%$/ { getline; print; exit }' "$desc")")
  files+=("$(awk '/^%FILENAME%$/ { getline; print; exit }' "$desc")")
done
has() {
  printf '%s\n' "${names[@]}" | grep -qxF "$1"
}
for name in "${names[@]}"; do
  case $name in
    agentv | agentv-keyring | agentv-voice) ;;
    *) echo "$url has a package this ISO doesn't expect: $name" >&2; exit 1 ;;
  esac
done
if ! has agentv || ! has agentv-keyring; then
  echo "expected agentv and agentv-keyring in $url, found: ${names[*]}" >&2
  exit 1
fi
if sed -n '/^%DEPENDS%$/,/^$/p' "$work"/db/agentv-[0-9]*/desc | grep -qx agentv-voice && ! has agentv-voice; then
  echo "agentv in $url needs agentv-voice, which isn't there" >&2
  exit 1
fi

for file in "${files[@]}"; do
  fetch "$file"
  fetch "$file.sig"
done

# The key comes out of agentv-keyring itself, and counts only if it's the
# one pinned here.
keyring=$(printf '%s\n' "${files[@]}" | grep '^agentv-keyring-')
tar -xf "$work/$keyring" -C "$work" usr/share/pacman/keyrings/agentv.gpg
gpg --batch --quiet --import "$work/usr/share/pacman/keyrings/agentv.gpg"
fpr=$(gpg --batch --with-colons --list-keys | awk -F: '/^fpr:/ { print $10; exit }')
if [[ $fpr != "$pinned" ]]; then
  echo "agentv-keyring carries key $fpr, but this ISO trusts only $pinned" >&2
  exit 1
fi

# gpgv accepts a signature only from a key in the keyring it's given, and
# that keyring holds the pinned key alone.
gpg --batch --export "$pinned" >"$work/trusted.gpg"
gpgv --quiet --keyring "$work/trusted.gpg" "$work/agentv.db.sig" "$work/agentv.db"
for file in "${files[@]}"; do
  gpgv --quiet --keyring "$work/trusted.gpg" "$work/$file.sig" "$work/$file"
done

mkdir -p "$dest"
rm -f "$dest"/*.pkg.tar.zst
for file in "${files[@]}"; do
  cp "$work/$file" "$dest/"
done
echo "AgenTV packages for the ISO, signatures checked against $pinned:"
printf '  %s\n' "${files[@]}"
